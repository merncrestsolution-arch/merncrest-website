# Local Docker (compose maps host 5434 → container 5432)
DATABASE_URL="postgresql://merncrest:merncrest@localhost:5434/merncrest?schema=public"

# Production / Vercel: Neon, Supabase, or Vercel Postgres
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/merncrest?sslmode=require"

AUTH_SECRET="generate-a-long-random-secret-for-production"
NEXT_PUBLIC_SITE_URL="https://merncrest.lk"

# Official @merncrest.lk mailboxes (create in Google Workspace / Zoho / your registrar)
# MAIL_FROM_ADDRESS="noreply@merncrest.lk"
# MAIL_REPLY_TO="contact@merncrest.lk"
# MAIL_FROM_NAME="MernCrest"
CONTACT_EMAIL="contact@merncrest.lk"

# Payments — automatic gateways OFF by default (manual / bank transfer + admin verification)
PAYMENT_GATEWAY_ENABLED="false"
PAYMENT_DEMO_ENABLED="true"
BANK_NAME="Commercial Bank of Ceylon"
BANK_ACCOUNT_NAME="MernCrest Solutions (Pvt) Ltd"
BANK_ACCOUNT_NUMBER="1234567890"
BANK_BRANCH="Colombo"
# Dual bank accounts shown at checkout
BANK_COMMERCIAL_NAME="Commercial Bank of Ceylon"
BANK_COMMERCIAL_ACCOUNT_NAME="MernCrest Solutions (Pvt) Ltd"
BANK_COMMERCIAL_ACCOUNT_NUMBER="1234567890"
BANK_COMMERCIAL_BRANCH="Colombo"
BANK_PEOPLES_NAME="People's Bank"
BANK_PEOPLES_ACCOUNT_NAME="MernCrest Solutions (Pvt) Ltd"
BANK_PEOPLES_ACCOUNT_NUMBER="0987654321"
BANK_PEOPLES_BRANCH="Colombo Fort"

# AI provider API key encryption (AES-256-GCM). Falls back to PII_ENCRYPTION_KEY / AUTH_SECRET.
AI_CONFIG_SECRET=""

# OpenAI (chatbot) — preferred quick config; also configurable in Admin → AI Providers
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
OPENAI_MAX_TOKENS="1500"

# Sri Lanka VAT % used by admin invoice builder (default 18)
VAT_RATE_PERCENT="18"

# Commerce document numbers: ORD-ERP-45872 · INV-ERP-45873 · RCP-ERP-45874
COMMERCE_NUMBER_SEGMENT="ERP"
COMMERCE_NUMBER_START="45872"

# PII encryption (AES-256-GCM). Prefer a dedicated 32+ char secret; falls back to AUTH_SECRET.
PII_ENCRYPTION_KEY=""

# PayHere (Sri Lanka) — enable with PAYMENT_GATEWAY_ENABLED=true
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""
PAYHERE_SANDBOX="true"

# Namecheap (international domains) — whitelist server IP in Namecheap API panel
NAMECHEAP_API_USER=""
NAMECHEAP_API_KEY=""
NAMECHEAP_USERNAME=""
NAMECHEAP_CLIENT_IP=""
NAMECHEAP_SANDBOX="true"
# USD → LKR for wholesale estimate when live pricing not fetched
NAMECHEAP_USD_LKR_RATE="320"
# Flat LKR profit added to every domain (Namecheap + .lk provider cost → selling price).
DOMAIN_MARGIN_LKR="350"
# Flat LKR profit on hosting/VPS reseller packages (provider wholesale + margin = catalog price).
HOSTING_MARGIN_LKR="500"

# DomainLK / .lk reseller (RegisterHere, Green Line, etc. — after partnership)
DOMAINLK_API_URL=""
DOMAINLK_API_KEY=""
DOMAINLK_API_SECRET=""

# Meta WhatsApp Cloud API — business line 0713838638 (+94713838638)
WHATSAPP_BUSINESS_NUMBER="0713838638"
WHATSAPP_BUSINESS_NUMBER_E164="94713838638"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WABA_ID=""
WHATSAPP_VERIFY_TOKEN="merncrest-verify"
WHATSAPP_API_VERSION="v23.0"

# IVR / VOIP (Twilio | Vonage | Ozeki | stub) — recorded voice only, no AI voice
IVR_PROVIDER="stub"
IVR_FROM_NUMBER=""
IVR_WEBHOOK_SECRET=""
IVR_HOLD_MUSIC_URL="https://merncrest.lk/audio/ivr-hold.mp3"
IVR_AGENT_NUMBERS=""
IVR_RECORDING_BUCKET=""
# Twilio Voice (shared with WhatsApp Twilio if used)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# Vonage Voice
VONAGE_API_KEY=""
VONAGE_API_SECRET=""
VONAGE_APPLICATION_ID=""
# Webhook: POST {NEXT_PUBLIC_SITE_URL}/api/ivr/webhook?secret=IVR_WEBHOOK_SECRET

BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER=""
BREVO_SMTP_PASS=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# Cloudflare Turnstile — bot protection for login, staff login,
# careers apply, and contact-us messages. Protection is ENFORCED only when
# BOTH keys are set; if left blank, forms work normally (no verification).
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Chat file uploads (JPG/PNG/PDF) are always scanned: type/magic-byte anti-spoofing,
# executable + active-content blocking, and a 10 MB limit. Optionally add a
# VirusTotal API key for real-time AV reputation lookups (best-effort; skipped if blank).
# Get a free key at https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=""
