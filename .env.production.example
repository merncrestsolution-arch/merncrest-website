# =============================================================================
# MernCrest — production environment (AWS Lightsail + Docker Compose)
# Copy to `.env.production` on the server and fill in real values.
# NEVER commit the real .env.production.
# =============================================================================

# --- PostgreSQL (runs as the `postgres` service on the internal network) ---
# These three feed the postgres container AND must match DATABASE_URL below.
POSTGRES_USER="merncrest"
POSTGRES_PASSWORD="CHANGE_ME_strong_db_password"
POSTGRES_DB="merncrest"

# Host = the compose service name `postgres`, internal port 5432.
DATABASE_URL="postgresql://merncrest:CHANGE_ME_strong_db_password@postgres:5432/merncrest?schema=public"

# --- Redis (runs as the `redis` service on the internal network) ---
REDIS_URL="redis://redis:6379"

# --- Auth / site ---
AUTH_SECRET="CHANGE_ME_long_random_secret_min_32_chars"
# Public URL your users hit (through Cloudflare).
NEXT_PUBLIC_SITE_URL="https://merncrest.lk"
MAIL_FROM_ADDRESS="noreply@merncrest.lk"
MAIL_REPLY_TO="contact@merncrest.lk"
MAIL_FROM_NAME="MernCrest"
CONTACT_EMAIL="contact@merncrest.lk"

# PII encryption (AES-256-GCM). Use a dedicated 32+ char secret.
PII_ENCRYPTION_KEY="CHANGE_ME_32_plus_char_secret"
AI_CONFIG_SECRET="CHANGE_ME_ai_config_secret"
VAT_RATE_PERCENT="18"

# Commerce document numbers: ORD-ERP-45872 · INV-ERP-45873 · RCP-ERP-45874
COMMERCE_NUMBER_SEGMENT="ERP"
COMMERCE_NUMBER_START="45872"

# --- Payments (manual / bank transfer by default) ---
PAYMENT_GATEWAY_ENABLED="false"
PAYMENT_DEMO_ENABLED="false"
BANK_NAME="Commercial Bank of Ceylon"
BANK_ACCOUNT_NAME="MernCrest Solutions (Pvt) Ltd"
BANK_ACCOUNT_NUMBER="1234567890"
BANK_BRANCH="Colombo"
BANK_COMMERCIAL_NAME="Commercial Bank of Ceylon"
BANK_COMMERCIAL_ACCOUNT_NAME="MernCrest Solutions (Pvt) Ltd"
BANK_COMMERCIAL_ACCOUNT_NUMBER="1234567890"
BANK_COMMERCIAL_BRANCH="Colombo"
BANK_PEOPLES_NAME="People's Bank"
BANK_PEOPLES_ACCOUNT_NAME="MernCrest Solutions (Pvt) Ltd"
BANK_PEOPLES_ACCOUNT_NUMBER="0987654321"
BANK_PEOPLES_BRANCH="Colombo Fort"

# PayHere (enable with PAYMENT_GATEWAY_ENABLED=true)
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""
PAYHERE_SANDBOX="false"

# --- Domains reseller ---
NAMECHEAP_API_USER=""
NAMECHEAP_API_KEY=""
NAMECHEAP_USERNAME=""
# Set to the Lightsail STATIC IP (whitelist it in Namecheap too).
NAMECHEAP_CLIENT_IP=""
NAMECHEAP_SANDBOX="false"
NAMECHEAP_USD_LKR_RATE="320"
DOMAINLK_API_URL=""
DOMAINLK_API_KEY=""
DOMAINLK_API_SECRET=""

# --- WhatsApp Cloud API ---
WHATSAPP_BUSINESS_NUMBER="0713838638"
WHATSAPP_BUSINESS_NUMBER_E164="94713838638"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WABA_ID=""
WHATSAPP_VERIFY_TOKEN="merncrest-verify"
WHATSAPP_API_VERSION="v23.0"

# --- IVR / VOIP ---
IVR_PROVIDER="stub"
IVR_FROM_NUMBER=""
IVR_WEBHOOK_SECRET=""
IVR_HOLD_MUSIC_URL="https://merncrest.lk/audio/ivr-hold.mp3"
IVR_AGENT_NUMBERS=""
IVR_RECORDING_BUCKET=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
VONAGE_API_KEY=""
VONAGE_API_SECRET=""
VONAGE_APPLICATION_ID=""

# --- Email (Brevo SMTP) ---
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER=""
BREVO_SMTP_PASS=""

# --- Media / maps ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# --- Cloudflare Turnstile (bot protection) ---
# Create at https://dash.cloudflare.com/?to=/:account/turnstile
# Add hostnames: merncrest.lk, system.merncrest.lk, and your server IP while testing.
# NEXT_PUBLIC_* is baked in at Docker build time — rebuild app after changing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Antivirus for chat uploads (optional) ---
VIRUSTOTAL_API_KEY=""
