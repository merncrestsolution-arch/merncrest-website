enum ServiceStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
  PENDING_RENEWAL
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_TIME
}

enum DomainStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  TRANSFERRED
  SUSPENDED
}

enum HostingStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

/// Service-delivery project (multi-service). Distinct from ErpProject.
model Project {
  id           String        @id @default(cuid())
  clientId     String
  name         String
  status       ProjectStatus @default(ACTIVE)
  erpProjectId String?       @unique
  services     ProjectService[]
  invoices     Invoice[]     @relation("ServiceProjectInvoices")
  accessRequests CrossClientAccessRequest[]
  businessMailboxes BusinessMailbox[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  createdBy    String
  updatedBy    String
  client       User          @relation("ProjectClient", fields: [clientId], references: [id])
  erpProject   ErpProject?   @relation("ErpServiceProject", fields: [erpProjectId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([status])
  @@index([deletedAt])
  @@index([erpProjectId])
}

model ProjectService {
  id                   String        @id @default(cuid())
  projectId            String
  serviceType          ServiceType
  status               ServiceStatus @default(ACTIVE)
  startDate            DateTime
  freePeriodDays       Int?
  billingCycle         BillingCycle  @default(ANNUAL)
  renewalDate          DateTime?
  expiryDate           DateTime?
  metadata             Json?
  /// Days before renewal to send reminders (Phase 4 reads this)
  reminderScheduleDays Int[]         @default([3])
  project              Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceDomain        ServiceDomain?
  serviceHosting       ServiceHostingAccount?
  domainDocSubmissions DomainRegistrationSubmission[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?
  createdBy            String
  updatedBy            String

  @@index([projectId])
  @@index([serviceType])
  @@index([status])
  @@index([renewalDate])
  @@index([deletedAt])
}

/// Domain record scoped to a ProjectService of type DOMAIN_REGISTRATION
model ServiceDomain {
  id                    String               @id @default(cuid())
  projectServiceId      String               @unique
  domainName            String
  domainExtension       String?
  registrar             String?
  purchasedViaMernCrest Boolean              @default(false)
  registrationDate      DateTime
  expiryDate            DateTime
  renewalDate           DateTime?
  registrationPeriodMonths Int?
  nameservers           String[]
  dnsRecords            Json?
  dnsZone               String?
  sslCertificateStatus  String               @default("UNKNOWN")
  autoRenew             Boolean              @default(false)
  whoisStatus           String?
  domainStatus          DomainStatus         @default(ACTIVE)
  projectService        ProjectService       @relation(fields: [projectServiceId], references: [id], onDelete: Cascade)
  history               ServiceDomainHistoryEntry[]
  dnsChangeRequests     DnsChangeRequest[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deletedAt             DateTime?
  createdBy             String
  updatedBy             String

  @@index([domainName])
  @@index([expiryDate])
  @@index([renewalDate])
  @@index([domainStatus])
  @@index([deletedAt])
}

model ServiceDomainHistoryEntry {
  id        String        @id @default(cuid())
  domainId  String
  action    String
  detail    Json?
  domain    ServiceDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  createdBy String

  @@index([domainId])
  @@index([createdAt])
}

/// Hosting account scoped to a ProjectService of type HOSTING
model ServiceHostingAccount {
  id               String                    @id @default(cuid())
  projectServiceId String                    @unique
  packageName      String
  diskQuotaMb      Int
  bandwidthQuotaMb Int
  diskUsedMb       Int                       @default(0)
  bandwidthUsedMb  Int                       @default(0)
  serverLocation   String?
  serverStatus     String                    @default("UNKNOWN")
  cpuUsagePct      Float                     @default(0)
  memoryUsagePct   Float                     @default(0)
  sslStatus        String                    @default("UNKNOWN")
  uptimePct        Float                     @default(100)
  hostingStatus    HostingStatus             @default(ACTIVE)
  renewalDate      DateTime
  expiryDate       DateTime
  projectService   ProjectService            @relation(fields: [projectServiceId], references: [id], onDelete: Cascade)
  history          ServiceHostingHistoryEntry[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  deletedAt        DateTime?
  createdBy        String
  updatedBy        String

  @@index([hostingStatus])
  @@index([renewalDate])
  @@index([expiryDate])
  @@index([deletedAt])
}

model ServiceHostingHistoryEntry {
  id             String                @id @default(cuid())
  hostingId      String
  action         String
  detail         Json?
  hostingAccount ServiceHostingAccount @relation(fields: [hostingId], references: [id], onDelete: Cascade)
  createdAt      DateTime              @default(now())
  createdBy      String

  @@index([hostingId])
  @@index([createdAt])
}

enum DomainDocStatus {
  PENDING
  APPROVED
  REJECTED
  CORRECTIONS_REQUESTED
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Domain registration documentation submitted by client
model DomainRegistrationSubmission {
  id                String          @id @default(cuid())
  projectServiceId  String
  projectService    ProjectService  @relation(fields: [projectServiceId], references: [id], onDelete: Cascade)
  fullName          String
  companyName       String?
  purpose           String
  phone             String
  email             String
  letterheadUrl     String?
  supportingDocsJson Json?
  idDocsJson        Json?
  status            DomainDocStatus @default(PENDING)
  reviewNotes       String?
  reviewedBy        String?
  reviewer          User?           @relation("DomainDocReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  submittedBy       String
  submitter         User            @relation("DomainDocSubmitter", fields: [submittedBy], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  createdBy         String
  updatedBy         String

  @@index([projectServiceId])
  @@index([status])
  @@index([deletedAt])
}

/// Sales agent assigned to a client account
model SalesClientAssignment {
  id        String   @id @default(cuid())
  agentId   String
  agent     User     @relation("SalesAgent", fields: [agentId], references: [id], onDelete: Cascade)
  clientId  String
  client    User     @relation("SalesClient", fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  createdBy String

  @@unique([agentId, clientId])
  @@index([agentId])
  @@index([clientId])
}

/// Cross-client access request from sales agent
model CrossClientAccessRequest {
  id          String              @id @default(cuid())
  requesterId String
  requester   User                @relation("AccessRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  clientId    String
  client      User                @relation("AccessRequestClient", fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reason      String
  status      AccessRequestStatus @default(PENDING)
  reviewedBy  String?
  reviewer    User?               @relation("AccessReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewNotes String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([requesterId])
  @@index([clientId])
  @@index([status])
}

enum DnsChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
}

/// Client-submitted DNS change request for MernCrest-managed domains
model DnsChangeRequest {
  id              String                 @id @default(cuid())
  serviceDomainId String
  serviceDomain   ServiceDomain          @relation(fields: [serviceDomainId], references: [id], onDelete: Cascade)
  requestedBy     String
  requester       User                   @relation("DnsChangeRequester", fields: [requestedBy], references: [id])
  status          DnsChangeRequestStatus @default(PENDING)
  proposedRecords Json
  clientNotes     String?
  reviewNotes     String?
  reviewedBy      String?
  reviewer        User?                  @relation("DnsChangeReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  appliedAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?
  createdBy       String
  updatedBy       String

  @@index([serviceDomainId])
  @@index([requestedBy])
  @@index([status])
  @@index([deletedAt])
}

enum BusinessMailboxStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

/// Client professional email mailbox (@merncrest.lk or custom domain)
model BusinessMailbox {
  id            String                @id @default(cuid())
  userId        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  email         String                @unique
  localPart     String
  domain        String                @default("merncrest.lk")
  passwordEnc   String
  smtpHost      String?
  smtpPort      Int                   @default(587)
  imapHost      String?
  imapPort      Int                   @default(993)
  status        BusinessMailboxStatus @default(PENDING)
  projectId     String?
  project       Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  provisionedAt DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deletedAt     DateTime?
  createdBy     String
  updatedBy     String

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([deletedAt])
}
