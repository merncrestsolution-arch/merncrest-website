generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  fullName         String
  company          String?
  /// CUSTOMER | STAFF | ADMIN | OWNER
  role             String    @default("CUSTOMER")
  emailVerifiedAt  DateTime?
  emailVerifyToken String?   @unique
  /// System staff 2FA flag (Phase 6)
  twoFactorEnabled Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions         Session[]
  profile          CustomerProfile?
  cart             Cart?
  orders           Order[]
  invoices         Invoice[]
  payments         Payment[]
  domains          Domain[]
  hostingAccounts  HostingAccount[]
  subscriptions    Subscription[]
  refundRequests   RefundRequest[]
  tickets          Ticket[]
  ticketMessages   TicketMessage[]
  notifications    Notification[]
  chatSessions     ChatSession[]
  crmLeadsOwned    CrmLead[]       @relation("LeadOwner")
  crmLeadsAsTeamLead CrmLead[]     @relation("LeadTeamLead")
  crmActivities   CrmActivity[]
  callbackRequests CallbackRequest[]
  quotations       Quotation[]
  callRecords      CallRecord[]
  employee         Employee?
  leaveRequests    LeaveRequest[]  @relation("LeaveEmployee")
  leaveApprovals   LeaveRequest[]  @relation("LeaveApprover")
  leaveBalances    LeaveBalance[]
  projectMembers   ProjectMember[]
  tasksAssigned    ProjectTask[]   @relation("TaskAssignee")
  tasksDelegated   ProjectTask[]   @relation("TaskDelegator")
  taskComments     TaskComment[]
  taskAttachments  TaskAttachment[]
  taskTimeEntries  TaskTimeEntry[]
  financeEntries   FinanceEntry[]
  permissions      StaffPermission[]
  workOrders       WorkOrder[]     @relation("WorkOrderAssignee")
  attendance       AttendanceRecord[]
  documents        Document[]      @relation("DocUploader")
  documentVersions DocumentVersion[] @relation("DocVersionUploader")
  internalMessages InternalMessage[] @relation("MsgSender")
  internalMessagesReceived InternalMessage[] @relation("MsgRecipient")
  vendorsManaged   Vendor[]        @relation("VendorOwner")
  activities       CustomerActivity[]
  downloads        CustomerDownload[]
  performanceReviewsAsSubject PerformanceReview[] @relation("ReviewSubject")
  performanceReviewsAsReviewer PerformanceReview[] @relation("ReviewReviewer")
  kpiTargets       KpiTarget[]
  kpiEntries       KpiEntry[]
  projectsAsCustomer ErpProject[] @relation("ProjectCustomer")
  calendarEvents   CalendarEvent[] @relation("CalendarOwner")
  trainingRecords  TrainingRecord[]
  notificationPrefs NotificationPreference?
  performanceAlerts PerformanceAlert[]
  skillAssessments SkillAssessment[] @relation("SkillSubject")
  skillAssessmentsGiven SkillAssessment[] @relation("SkillAssessor")
  pipsAsSubject    PerformanceImprovementPlan[] @relation("PipSubject")
  pipsAsManager    PerformanceImprovementPlan[] @relation("PipManager")
  complaintsAssigned Complaint[] @relation("ComplaintAssignee")
  complaintsFiled  Complaint[] @relation("ComplaintFiler")
  roomBookings     RoomBooking[]
  scheduledNotifications ScheduledNotification[]
  knowledgeArticles KnowledgeArticle[] @relation("KbAuthor")
  routingRulesCreated RoutingRule[] @relation("RoutingRuleCreator")
  overtimeRequests OvertimeRequest[] @relation("OvertimeRequester")
  overtimeApprovals OvertimeRequest[] @relation("OvertimeApprover")
  supportAgent     SupportAgent?
  messageTemplatesCreated MessageTemplate[] @relation("TemplateCreator")
  suggestionEvents SuggestionEvent[] @relation("SuggestionActor")
  emailOutboxRecorded EmailOutbox[] @relation("EmailOutboxActor")
  clientProjects       Project[] @relation("ProjectClient")
  salesAssignments     SalesClientAssignment[] @relation("SalesAgent")
  accessRequestsFiled  CrossClientAccessRequest[] @relation("AccessRequester")
  accessRequestsReviewed CrossClientAccessRequest[] @relation("AccessReviewer")
  domainDocSubmissions DomainRegistrationSubmission[] @relation("DomainDocSubmitter")
  domainDocReviews     DomainRegistrationSubmission[] @relation("DomainDocReviewer")
  dnsChangeRequests    DnsChangeRequest[]             @relation("DnsChangeRequester")
  dnsChangeReviews     DnsChangeRequest[]             @relation("DnsChangeReviewer")
  salesClientOf        SalesClientAssignment[] @relation("SalesClient")
  accessRequestsAsClient CrossClientAccessRequest[] @relation("AccessRequestClient")
  businessMailboxes    BusinessMailbox[]

  @@index([role])
}

model CustomerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Public unique customer ID e.g. MC-A1B2C3
  customerCode       String?  @unique
  photoUrl           String?
  phone              String?
  whatsapp           String?
  address            String?
  city               String?
  province           String?
  postalCode         String?
  country            String?  @default("Sri Lanka")
  /// Encrypted at rest (AES-256-GCM) — see lib/security/pii.ts. Retention: policy TBD (PDPA).
  businessReg        String?
  /// Encrypted at rest (AES-256-GCM) — see lib/security/pii.ts. Retention: policy TBD (PDPA).
  nicPassport        String?
  timezone           String?  @default("Asia/Colombo")
  preferredLanguage  String?  @default("en")
  /// Communication preferences
  notifyEmail        Boolean  @default(true)
  notifyWhatsApp     Boolean  @default(true)
  notifySms          Boolean  @default(false)
  marketingOptIn     Boolean  @default(false)
  /// Assigned staff (Customer 360)
  assignedSalesId    String?
  assignedSupportId  String?
  /// GOOD | AVERAGE | AT_RISK | VIP
  customerRating     String?  @default("GOOD")
  /// JSON string array of segment tags e.g. ["VIP","HOSTING"]
  tagsJson           String?
  /// JSON object of custom CRM fields
  customFieldsJson   String?
  /// Parent company / account contact (hierarchy)
  parentProfileId    String?
  parentProfile      CustomerProfile?  @relation("ContactHierarchy", fields: [parentProfileId], references: [id], onDelete: SetNull)
  childProfiles      CustomerProfile[] @relation("ContactHierarchy")
  creditBalanceCents Int      @default(0)
  notes              String?
  /// Extended company profile fields
  companyWebsite     String?
  industry           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?

  contacts           ClientContact[]
  documents          Document[]        @relation("ClientDocuments")

  @@index([parentProfileId])
  @@index([customerRating])
  @@index([deletedAt])
}

/// Additional contacts for a client account (beyond primary User)
model ClientContact {
  id        String          @id @default(cuid())
  profileId String
  profile   CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  email     String?
  phone     String?
  isPrimary Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([profileId])
  @@index([deletedAt])
}

/// Portal / CRM-linked customer activity trail
model CustomerActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ORDER | PAYMENT | TICKET | DOMAIN | HOSTING | LOGIN | PROFILE | SYSTEM
  category  String   @default("SYSTEM")
  title     String
  body      String?
  href      String?
  metaJson  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([category])
}

/// Platform announcements — customer portal + internal staff feed
model Announcement {
  id           String    @id @default(cuid())
  title        String
  body         String
  /// Optional HTML rich text (falls back to body)
  bodyHtml     String?
  /// INFO | WARNING | SUCCESS | PROMO
  tone         String    @default("INFO")
  href         String?
  /// PORTAL | STAFF | BOTH
  surface      String    @default("PORTAL")
  /// DRAFT | SCHEDULED | PUBLISHED | EXPIRED
  status       String    @default("PUBLISHED")
  /// ALL_STAFF | ROLE | TEAM
  audience     String    @default("ALL_STAFF")
  /// JSON: roles[] or orgRoles[] depending on audience
  audienceJson String?
  scheduledFor DateTime?
  publishedAt  DateTime?
  active       Boolean   @default(true)
  startsAt     DateTime  @default(now())
  endsAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?

  @@index([active])
  @@index([startsAt])
  @@index([surface])
  @@index([status])
  @@index([scheduledFor])
  @@index([deletedAt])
}

/// Customer downloadable assets (invoices PDF links, licenses, manuals)
model CustomerDownload {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Global assets when userId is null
  title       String
  description String?
  /// INVOICE | RECEIPT | LICENSE | MANUAL | SOFTWARE | DOCUMENT
  category    String   @default("DOCUMENT")
  fileUrl     String
  fileType    String?  @default("PDF")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([category])
  @@index([active])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

/// Third-party reseller provider (domains, hosting, VPS, SSL, email, cloud).
/// MernCrest does NOT own hosting infrastructure — services are purchased via Provider APIs.
model Provider {
  id                 String    @id @default(cuid())
  name               String
  /// Stable code e.g. mock-a | provider-b
  code               String    @unique
  /// DOMAIN | HOSTING | SSL | EMAIL | CLOUD | MULTI
  providerType       String    @default("MULTI")
  apiUrl             String?
  apiKey             String?
  apiSecret          String?
  /// JSON array: ["domains","hosting","vps","ssl","email","cloud"]
  supportedServices  String    @default("[]")
  /// ACTIVE | INACTIVE | ERROR
  status             String    @default("ACTIVE")
  /// Lower = higher priority when routing
  priority           Int       @default(100)
  /// IDLE | SYNCING | SUCCESS | FAILED
  syncStatus         String    @default("IDLE")
  lastSyncedAt       DateTime?
  /// Fallback fixed margin (cents) when category margin missing
  defaultMarginCents Int       @default(0)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  products        Product[]
  domains         Domain[]
  hostingAccounts HostingAccount[]

  @@index([status])
  @@index([priority])
}

/// Configurable profit margins by product category.
/// Selling Price = Provider Price + Margin (fixed and/or percent).
model PricingMargin {
  id            String   @id @default(cuid())
  /// domains | hosting | vps | ssl | email | cloud
  category      String   @unique
  marginCents   Int      @default(0)
  marginPercent Float    @default(0)
  /// FIXED | PERCENT | BOTH — FIXED uses marginCents; PERCENT uses marginPercent; BOTH adds both.
  /// Existing rows keep FIXED (do not silently change stored values). New USD products default to PERCENT.
  marginMode    String   @default("FIXED")
  /// Extra % on FX conversion (USD→LKR) to absorb rate movement between quote and purchase
  fxBufferPercent Float  @default(2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Product {
  id                 String    @id @default(cuid())
  slug               String    @unique
  name               String
  description        String
  category           String
  /// Public selling price (provider cost + margin)
  priceCents         Int
  /// Internal provider cost (hidden from customer invoices)
  providerPriceCents Int?
  currency           String    @default("LKR")
  /// ONCE | MONTHLY | YEARLY
  billingPeriod      String    @default("ONCE")
  active             Boolean   @default(true)
  featured           Boolean   @default(false)
  sortOrder          Int       @default(0)
  providerId         String?
  provider           Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  /// External SKU / package id at the provider
  providerProductId  String?
  /// Admin marketing overrides (public catalog still uses name/description as fallback)
  marketingTitle     String?
  marketingBanner    String?
  marketingBody      String?
  /// JSON package specs synced from provider
  specsJson          String?
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([category])
  @@index([active])
  @@index([providerId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  /// Sales-set unit price (LKR cents). When set, overrides Product.priceCents.
  unitPriceCents Int?
  /// Display label for sales custom / project lines
  lineLabel String?
  /// When true, quantity is fixed by Sales (customer may still remove)
  salesLocked Boolean @default(false)
  /// JSON: domainName, tld, planCode, leadId, advancePercent, projectTotalCents, etc.
  metaJson  String?
  /// Provider wholesale currency at quote (USD | LKR)
  providerCurrency     String?
  /// Locked USD→LKR rate at quote time (units of LKR per 1 USD)
  exchangeRate         Float?
  exchangeRateLockedAt DateTime?
  fxBufferPercent      Float?

  @@index([cartId])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  /// DRAFT | PENDING | WAITING_PAYMENT | PAID | PROCESSING | PROVISIONING | PROVISIONING_FAILED | COMPLETED | CANCELLED | REFUNDED
  status      String      @default("PENDING")
  subtotalCents Int
  taxCents      Int       @default(0)
  discountCents Int      @default(0)
  totalCents    Int
  currency      String    @default("LKR")
  couponCode    String?
  /// JSON registrant / billing contact snapshot
  registrantJson String?
  notes         String?
  /// Auto-provision retry counter (max 3 per activateOrderServices run)
  provisioningAttempts Int @default(0)
  lastProvisionError   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items           OrderItem[]
  invoice         Invoice?
  payments        Payment[]
  domains         Domain[]
  hostingAccounts HostingAccount[]
  subscriptions   Subscription[]
  refundRequests  RefundRequest[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName        String
  productSlug        String
  quantity           Int
  unitPriceCents     Int
  totalCents         Int
  /// Internal provider cost snapshot in selling currency (LKR cents after FX)
  providerCostCents  Int?
  /// Original provider currency before FX (USD | LKR)
  providerCurrency     String?
  /// Locked USD→LKR rate used for this line
  exchangeRate         Float?
  exchangeRateLockedAt DateTime?
  fxBufferPercent      Float?
  billingPeriod      String   @default("ONCE")
  metaJson           String?
}

model Invoice {
  id                String          @id @default(cuid())
  invoiceNumber     String          @unique
  orderId           String          @unique
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  /// Optional links for multi-project / service billing
  projectId         String?
  project           ErpProject?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  serviceProjectId  String?
  serviceProject    Project?        @relation("ServiceProjectInvoices", fields: [serviceProjectId], references: [id], onDelete: SetNull)
  domainId          String?
  domain            Domain?         @relation(fields: [domainId], references: [id], onDelete: SetNull)
  hostingAccountId  String?
  hostingAccount    HostingAccount? @relation(fields: [hostingAccountId], references: [id], onDelete: SetNull)
  /// DRAFT | SENT | PAID | PARTIALLY_PAID | OVERDUE | CANCELLED | VOID
  status            String          @default("SENT")
  subtotalCents     Int
  taxCents          Int             @default(0)
  totalCents        Int
  /// Running sum of SUCCEEDED payments (cents)
  paidCents         Int             @default(0)
  currency          String          @default("LKR")
  /// JSON line items: { lines: [...], discountCents, vatRatePercent, notes, advanceCents? }
  lineItemsJson     String?
  dueAt             DateTime?
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?

  payments          Payment[]
  paymentSchedules  ProjectPaymentSchedule[]

  @@index([userId])
  @@index([status])
  @@index([projectId])
  @@index([serviceProjectId])
  @@index([domainId])
  @@index([hostingAccountId])
  @@index([dueAt])
  @@index([deletedAt])
}

model Payment {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceId    String?
  invoice      Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  /// RCP-ERP-45872 — assigned when payment is recorded
  receiptNumber String?  @unique
  amountCents  Int
  currency     String    @default("LKR")
  /// MANUAL | BANK_TRANSFER | DEMO | PAYHERE | STRIPE
  method       String    @default("MANUAL")
  /// PENDING | AWAITING_VERIFICATION | SUCCEEDED | FAILED | REJECTED | REFUNDED | PARTIAL
  status       String    @default("PENDING")
  /// Allow amount that creates client credit beyond invoice total
  isCredit     Boolean   @default(false)
  /// Advance / deposit payment (vs balance installment)
  isAdvance    Boolean   @default(false)
  recordedById String?
  paidAt       DateTime?
  providerRef  String?
  /// Bank transfer reference / customer note (legacy — prefer referenceNumber)
  proofNote    String?
  /// Bank transfer reference number (required for new submissions)
  referenceNumber String?
  /// Receipt / screenshot URL (required for new bank-transfer submissions)
  proofImageUrl   String?
  adminNote    String?
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?

  @@index([userId])
  @@index([orderId])
  @@index([invoiceId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model Domain {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id])
  orderId              String?
  order                Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  providerId           String?
  provider             Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  /// External registration id at the provider
  providerRef          String?
  /// Display registrar when provider relation is absent
  registrar            String?
  name                 String
  tld                  String
  /// PENDING | ACTIVE | EXPIRED | TRANSFERRING | LOCKED | CANCELLED
  status               String    @default("PENDING")
  autoRenew            Boolean   @default(true)
  locked               Boolean   @default(false)
  managedByMernCrest   Boolean   @default(false)
  registeredAt         DateTime?
  expiresAt            DateTime?
  registrationCostCents Int      @default(0)
  isFreeProvided       Boolean   @default(false)
  freeDurationLabel    String?
  renewalPeriodMonths  Int?
  renewalCostCents     Int       @default(0)
  /// Reseller nameservers (comma-separated)
  nameservers          String    @default("ns1.provider.example,ns2.provider.example")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdBy            String?
  updatedBy            String?
  deletedAt            DateTime?

  dnsRecords DnsRecord[]
  invoices   Invoice[]
  projectResources ProjectResource[]

  @@unique([name, tld])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([providerId])
  @@index([deletedAt])
}

model DnsRecord {
  id        String   @id @default(cuid())
  domainId  String
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  /// A | AAAA | CNAME | MX | TXT | NS
  type      String
  host      String
  value     String
  ttl       Int      @default(3600)
  priority  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([domainId])
  @@index([deletedAt])
}

model HostingAccount {
  id                      String    @id @default(cuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id])
  orderId                 String?
  order                   Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  providerId              String?
  provider                Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  /// External account id at the provider
  providerRef             String?
  /// Human-readable provider account identifier
  accountId               String?
  label                   String
  planCode                String
  /// PENDING | PROVISIONING | ACTIVE | SUSPENDED | CANCELLED
  status                  String    @default("PENDING")
  primaryDomain           String?
  /// JSON array of linked domain FQDNs
  linkedDomainsJson       String?
  diskMb                  Int       @default(10240)
  diskUsedMb              Int       @default(0)
  bandwidthGb             Int       @default(100)
  bandwidthUsedGb         Int       @default(0)
  cpuPercent              Int       @default(5)
  ramMb                   Int       @default(512)
  ramUsedMb               Int       @default(128)
  /// ACTIVE | EXPIRING_SOON | EXPIRED | NOT_CONFIGURED | PENDING | FAILED
  sslStatus               String    @default("PENDING")
  sslExpiresAt            DateTime?
  backupStatus            String    @default("OK")
  /// Provider control panel URL
  panelUrl                String?
  panelUsernameEncrypted  String?
  panelPasswordEncrypted  String?
  databaseName            String?
  databaseUsernameEncrypted String?
  databasePasswordEncrypted String?
  serverIp                String?
  /// JSON or free-text server specs
  serverSpecs             String?
  serverLocation          String?
  renewalPeriodMonths     Int?
  renewalCostCents        Int       @default(0)
  activatedAt             DateTime?
  renewsAt                DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  createdBy               String?
  updatedBy               String?
  deletedAt               DateTime?

  invoices                Invoice[]
  projectResources        ProjectResource[]

  @@index([userId])
  @@index([status])
  @@index([providerId])
  @@index([sslExpiresAt])
  @@index([deletedAt])
}

model Subscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  orderId       String?
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  productSlug   String
  productName   String
  /// ACTIVE | PAST_DUE | CANCELLED | PAUSED
  status        String    @default("ACTIVE")
  /// MONTHLY | YEARLY
  billingPeriod String
  amountCents   Int
  currency      String    @default("LKR")
  nextBillingAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([nextBillingAt])
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  /// PERCENT | FIXED
  type            String
  value           Int
  maxUses         Int?
  usedCount       Int       @default(0)
  minOrderCents   Int       @default(0)
  active          Boolean   @default(true)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
}

model RefundRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountCents Int
  reason      String
  /// PENDING | APPROVED | REJECTED | PAID
  status      String   @default("PENDING")
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

/// Support ticket (portal + admin + chat/WhatsApp escalation)
model Ticket {
  id           String   @id @default(cuid())
  ticketNumber String   @unique
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Guest contact when not logged in
  guestEmail   String?
  guestName    String?
  subject      String
  /// BILLING | TECHNICAL | SALES | DOMAIN | HOSTING | GENERAL | ENTERPRISE
  department   String   @default("GENERAL")
  /// LOW | MEDIUM | HIGH | URGENT
  priority     String   @default("MEDIUM")
  /// OPEN | IN_PROGRESS | WAITING | RESOLVED | CLOSED
  status       String   @default("OPEN")
  /// PORTAL | LIVE_CHAT | WHATSAPP | EMAIL | PHONE | IVR
  channel      String   @default("PORTAL")
  /// GENERAL | COMPLAINT | INQUIRY | ORDER | SUPPORT
  category     String   @default("GENERAL")
  assigneeId   String?
  assigneeName String?
  csatRating   Int?
  csatFeedback String?
  responseDueAt DateTime?
  resolveDueAt  DateTime?
  escalatedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  closedAt     DateTime?

  messages TicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([department])
  @@index([createdAt])
  @@index([responseDueAt])
  @@index([category])
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  /// CUSTOMER | STAFF | SYSTEM | AI
  authorRole String   @default("CUSTOMER")
  body       String
  internal   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([ticketId])
  @@index([createdAt])
}

/// Sales / support CRM lead
model CrmLead {
  id          String    @id @default(cuid())
  leadNumber  String?   @unique
  /// NEW | ASSIGNED | QUALIFIED | MEETING | QUOTATION | NEGOTIATION | WON | LOST | ON_HOLD
  /// Legacy CONTACTED was migrated to QUALIFIED (see scripts/migrate-crm-contacted.ts)
  stage       String    @default("NEW")
  source      String    @default("WEBSITE")
  fullName    String
  email       String
  phone       String?
  company     String?
  interest    String?
  notes       String?
  valueCents  Int       @default(0)
  budgetCents Int       @default(0)
  /// LOW | MEDIUM | HIGH | URGENT
  priority    String    @default("MEDIUM")
  /// 0–100 lead score
  leadScore   Int       @default(0)
  timeline    String?
  followUpAt  DateTime?
  ownerId     String?
  owner       User?     @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamLeadId  String?
  teamLead    User?     @relation("LeadTeamLead", fields: [teamLeadId], references: [id], onDelete: SetNull)
  /// JSON string array tags
  tagsJson    String?
  /// JSON custom fields / metadata
  customFieldsJson String?
  /// Win/loss analysis
  wonReason   String?
  lostReason  String?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  activities  CrmActivity[]
  quotations  Quotation[]
  followUps   CrmFollowUp[]
  meetings    CrmMeeting[]
  chatSessions ChatSession[]
  suggestionEvents SuggestionEvent[]

  @@index([stage])
  @@index([email])
  @@index([ownerId])
  @@index([followUpAt])
  @@index([leadScore])
  @@index([departmentId])
  @@index([teamLeadId])
}

model CrmActivity {
  id        String   @id @default(cuid())
  leadId    String?
  lead      CrmLead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// NOTE | CALL | EMAIL | WHATSAPP | MEETING | STATUS | CHAT | IVR | FORM
  type      String   @default("NOTE")
  body      String
  /// Optional channel link e.g. whatsapp message id
  channelRef String?
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
}

model CrmFollowUp {
  id          String    @id @default(cuid())
  leadId      String
  lead        CrmLead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assigneeId  String?
  /// CALL | WHATSAPP | EMAIL | MEETING | DEMO | REMINDER | ESCALATION
  type        String    @default("CALL")
  title       String
  notes       String?
  dueAt       DateTime
  /// PENDING | DONE | OVERDUE | CANCELLED
  status      String    @default("PENDING")
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([leadId])
  @@index([dueAt])
  @@index([status])
}

model CrmMeeting {
  id          String    @id @default(cuid())
  leadId      String?
  lead        CrmLead?  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId      String?
  /// CONSULTATION | ONLINE | OFFICE | TECHNICAL | SALES
  meetingType String    @default("CONSULTATION")
  title       String
  location    String?
  scheduledAt DateTime
  durationMin Int       @default(30)
  /// SCHEDULED | COMPLETED | CANCELLED | NO_SHOW
  status      String    @default("SCHEDULED")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([leadId])
  @@index([scheduledAt])
  @@index([status])
}

/// CSAT / NPS after ticket, call, meeting, project
model CustomerSatisfaction {
  id          String   @id @default(cuid())
  userId      String?
  leadId      String?
  /// TICKET | CALL | MEETING | PROJECT | CHAT | GENERAL
  channel     String   @default("GENERAL")
  referenceId String?
  rating      Int
  /// 0–10 NPS
  npsScore    Int?
  feedback    String?
  suggestions String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([channel])
  @@index([createdAt])
}

model ChatSession {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  visitorId      String
  organizationId String?
  locale         String   @default("en")
  /// Sales | Technical | Hosting | Billing | Domain | Enterprise
  department     String?
  /// OPEN | HANDOFF | CLOSED | PENDING | RESOLVED
  status         String   @default("OPEN")
  /// WEB | FLUTTER
  channel        String   @default("WEB")
  /// AGENT | AI
  handlerType    String   @default("AI")
  agentId        String?
  agent          SupportAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  aiProvider     String?
  handoffRequested Boolean @default(false)
  leadId         String?
  lead           CrmLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  closedAt       DateTime?
  /// Set when staff closes chat and CSAT is requested from visitor
  csatRequestedAt DateTime?
  csatRating     Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages ChatMessage[]

  @@index([userId])
  @@index([visitorId])
  @@index([status])
  @@index([organizationId])
  @@index([handlerType])
  @@index([agentId])
  @@index([leadId])
  @@index([channel])
}

model ChatMessage {
  id              String      @id @default(cuid())
  sessionId       String
  session         ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// USER | AI | AGENT | SYSTEM
  role            String
  body            String
  /// Client-generated UUID for offline queue dedupe (Flutter / web)
  clientMessageId String?
  attachmentUrl   String?
  readAt          DateTime?
  createdAt       DateTime    @default(now())

  @@unique([sessionId, clientMessageId])
  @@index([sessionId])
  @@index([clientMessageId])
}

enum AgentStatus {
  ONLINE
  AWAY
  OFFLINE
}

model SupportAgent {
  id             String      @id @default(cuid())
  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  displayName    String
  avatarUrl      String?
  status         AgentStatus @default(OFFLINE)
  lastSeenAt     DateTime    @default(now())
  activeChats    Int         @default(0)
  maxConcurrent  Int         @default(5)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  sessions ChatSession[]

  @@index([organizationId])
  @@index([status])
  @@index([activeChats])
}

/// WhatsApp Business API message log (webhook stub)
model WhatsAppMessage {
  id             String   @id @default(cuid())
  waId           String?
  direction      String
  /// IN | OUT
  phone          String
  body           String
  /// RECEIVED | SENT | DELIVERED | READ | FAILED | AI_REPLIED | SCHEDULED
  status         String   @default("RECEIVED")
  localeHint     String?
  /// text | image | document | video | template
  mediaType      String?
  mediaUrl       String?
  templateName   String?
  conversationId String?
  conversation   WhatsAppConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assigneeId     String?
  qualityRating  Int?
  responseMs     Int?
  scheduledAt    DateTime?
  metaJson       String?
  createdAt      DateTime @default(now())

  @@index([phone])
  @@index([createdAt])
  @@index([conversationId])
  @@index([status])
  @@index([scheduledAt])
}

model WhatsAppConversation {
  id           String   @id @default(cuid())
  phone        String   @unique
  customerName String?
  /// OPEN | PENDING | ASSIGNED | CLOSED
  status       String   @default("OPEN")
  assigneeId   String?
  lastMessageAt DateTime @default(now())
  unreadCount  Int      @default(0)
  qualityAvg   Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  messages     WhatsAppMessage[]

  @@index([status])
  @@index([assigneeId])
  @@index([lastMessageAt])
}

/// Meta-approved or local stub templates
model WhatsAppTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  /// Meta template name / Twilio content SID
  providerKey String?
  category    String   @default("UTILITY")
  /// EN | TA | SI
  locale      String   @default("EN")
  body        String
  /// JSON array of variable placeholders e.g. ["name","orderId"]
  variablesJson String?
  /// APPROVED | PENDING | REJECTED | LOCAL
  status      String   @default("LOCAL")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([category])
}

/// Simple automation rules for transactional WA
model WhatsAppAutomation {
  id          String   @id @default(cuid())
  name        String
  /// INQUIRY | NEW_ORDER | PAYMENT_DUE | LEAVE_STATUS | TASK_ASSIGN | TICKET_UPDATE | ATTENDANCE
  trigger     String
  templateId  String?
  bodyTemplate String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([trigger])
  @@index([active])
}

/// Multi-day payment reminder drip (e.g. day 0 / +3 / +7)
model PaymentDripSequence {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// JSON DripStep[]: [{ dayOffset, bodyTemplate, templateName? }]
  stepsJson   String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments PaymentDripEnrollment[]

  @@index([active])
}

model PaymentDripEnrollment {
  id           String   @id @default(cuid())
  sequenceId   String
  sequence     PaymentDripSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  invoiceId    String?
  userId       String?
  phone        String
  currentStep  Int      @default(0)
  nextRunAt    DateTime
  /// ACTIVE | COMPLETED | CANCELLED
  status       String   @default("ACTIVE")
  varsJson     String?
  lastSentAt   DateTime?
  lastError    String?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, nextRunAt])
  @@index([invoiceId])
  @@index([phone])
}

/// IVR / phone callback queue
model CallbackRequest {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName    String
  phone       String
  email       String?
  /// SALES | SUPPORT | BILLING | TECHNICAL
  reason      String   @default("SUPPORT")
  preferredAt String?
  notes       String?
  /// PENDING | SCHEDULED | COMPLETED | CANCELLED
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  /// SYSTEM | BILLING | SUPPORT | ORDER | SECURITY
  category  String   @default("SYSTEM")
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}

model Quotation {
  id            String   @id @default(cuid())
  quoteNumber   String   @unique
  leadId        String?
  lead          CrmLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// DRAFT | PENDING_REVIEW | SENT | ACCEPTED | REJECTED | CHANGES_REQUESTED | EXPIRED
  status        String   @default("DRAFT")
  customerName  String
  customerEmail String
  company       String?
  subtotalCents Int
  taxCents      Int      @default(0)
  discountCents Int      @default(0)
  totalCents    Int
  currency      String   @default("LKR")
  validUntil    DateTime?
  terms         String?
  notes         String?
  orderId       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items QuotationItem[]

  @@index([leadId])
  @@index([userId])
  @@index([status])
}

model QuotationItem {
  id             String    @id @default(cuid())
  quotationId    String
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int       @default(1)
  unitPriceCents Int
  totalCents     Int
}

/// IVR / landline call log
model CallRecord {
  id           String   @id @default(cuid())
  callNumber   String   @unique
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  phone        String
  /// si | ta | en
  language     String   @default("en")
  /// SALES | TECHNICAL | HOSTING | DOMAIN | BILLING | ENTERPRISE | EXISTING | CARE | VOICEMAIL
  department   String   @default("CARE")
  agentName    String?
  /// RINGING | ANSWERED | MISSED | VOICEMAIL | CALLBACK | QUEUED | HOLD | COMPLETED
  status       String   @default("MISSED")
  durationSec  Int      @default(0)
  holdSec      Int      @default(0)
  recordingUrl String?
  notes        String?
  disposition  String?
  /// ROUTE | ATTENDANCE | TICKET | ORDER_STATUS | PAYMENT | SEVERITY | APPOINTMENT | SURVEY
  useCase      String?
  /// IDLE | QUEUED | HOLD | CONNECTED | COMPLETED
  queueStatus  String?
  /// LOW | MEDIUM | HIGH | CRITICAL
  severity     String?
  /// DTMF path e.g. "3-1-5"
  dtmfPath     String?
  /// stub | twilio | vonage | ozeki
  provider     String?  @default("stub")
  providerCallSid String?
  surveyScore  Int?
  ticketId     String?
  leadId       String?
  appointmentAt DateTime?
  alertSentAt  DateTime?
  metaJson     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events CallEvent[]

  @@index([userId])
  @@index([status])
  @@index([department])
  @@index([queueStatus])
  @@index([useCase])
  @@index([providerCallSid])
  @@index([createdAt])
}

/// DTMF / IVR lifecycle events for a call
model CallEvent {
  id        String     @id @default(cuid())
  callId    String
  call      CallRecord @relation(fields: [callId], references: [id], onDelete: Cascade)
  /// RING | ANSWER | LANG | DTMF | HOLD | TRANSFER | RECORD | VOICEMAIL | HANGUP | ALERT | SURVEY | USE_CASE
  type      String
  digit     String?
  promptKey String?
  detail    String?
  createdAt DateTime   @default(now())

  @@index([callId])
  @@index([type])
  @@index([createdAt])
}

/// —— Part 05: Internal ERP ——

model Department {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  parentId    String?
  parent      Department?  @relation("DeptTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Department[] @relation("DeptTree")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  employees   Employee[]
  projects    ErpProject[]
  crmLeads    CrmLead[]
  costCenter  String?

  @@index([parentId])
}

model Employee {
  id             String      @id @default(cuid())
  employeeCode   String      @unique
  userId         String?     @unique
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  branchId       String?
  branch         Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  fullName       String
  email          String
  phone          String?
  workPhone      String?
  dateOfBirth    DateTime?
  /// Encrypted at rest — lib/security/pii.ts
  nicEncrypted   String?
  photoUrl       String?
  designation    String?
  grade          String?
  emergencyName  String?
  emergencyPhone String?
  /// Encrypted bank account
  bankAccountEncrypted String?
  bankName       String?
  qualifications String?
  /// FULL_TIME | PART_TIME | CONTRACT | INTERN
  employmentType String      @default("FULL_TIME")
  jobTitle       String
  /// CEO | DIRECTOR | DEPT_HEAD | TEAM_LEAD | HR | FINANCE | SALES | ... | STAFF
  orgRole        String      @default("STAFF")
  /// ACTIVE | ON_LEAVE | INACTIVE | TERMINATED
  status         String      @default("ACTIVE")
  hireDate       DateTime    @default(now())
  salaryCents    Int         @default(0)
  managerId      String?
  manager        Employee?   @relation("EmployeeReports", fields: [managerId], references: [id], onDelete: SetNull)
  directReports  Employee[]  @relation("EmployeeReports")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  attendance       AttendanceRecord[]
  payrollLines     PayrollLine[]
  leaveBalances    LeaveBalance[]
  trainingRecords  TrainingRecord[]
  certifications   EmployeeCertification[]
  documents        EmployeeDocument[]
  overtimeRequests OvertimeRequest[]

  @@index([departmentId])
  @@index([branchId])
  @@index([status])
  @@index([email])
  @@index([orgRole])
  @@index([managerId])
}

model LeaveRequest {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("LeaveEmployee", fields: [userId], references: [id], onDelete: Cascade)
  /// ANNUAL | CASUAL | SICK | UNPAID | MATERNITY | PATERNITY | STUDY | OTHER
  leaveType  String   @default("ANNUAL")
  startDate  DateTime
  endDate    DateTime
  days       Float    @default(1)
  reason     String?
  /// PENDING | APPROVED | REJECTED | CANCELLED
  status     String   @default("PENDING")
  approverId String?
  approver   User?    @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model LeaveBalance {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  /// ANNUAL | CASUAL | SICK | UNPAID | MATERNITY | PATERNITY | STUDY | OTHER
  leaveType  String
  year       Int
  entitled   Float     @default(0)
  used       Float     @default(0)
  pending    Float     @default(0)
  updatedAt  DateTime  @updatedAt
  createdAt  DateTime  @default(now())

  @@unique([userId, leaveType, year])
  @@index([employeeId])
}

model ErpProject {
  id           String      @id @default(cuid())
  projectCode  String      @unique
  name         String
  description  String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  /// Customer account linked to this delivery project
  customerId   String?
  customer     User?       @relation("ProjectCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  /// PLANNING | ACTIVE | ON_HOLD | COMPLETED | CANCELLED
  status       String      @default("PLANNING")
  budgetCents  Int         @default(0)
  spentCents   Int         @default(0)
  /// Contract / billed revenue
  revenueCents Int         @default(0)
  startDate    DateTime?
  endDate      DateTime?
  /// Next installment / payment due
  nextPaymentAt DateTime?
  nextPaymentCents Int     @default(0)
  /// Short brief shared with the client
  clientBrief  String?
  /// Concrete next steps (internal + client-facing)
  nextSteps    String?
  /// Process stage label e.g. "Discovery → Design approval → Build"
  nextProcess  String?
  /// Internal-only development notes (not client-visible)
  developmentNotes     String?
  /// When set, overrides auto-computed task/milestone progress
  progressOverridePct  Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  members    ProjectMember[]
  tasks      ProjectTask[]
  milestones ProjectMilestone[]
  expenses   ProjectExpense[]
  payments   ProjectPaymentSchedule[]
  clientUpdates ProjectClientUpdate[]
  invoices   Invoice[]
  resource   ProjectResource?
  backlogItems ProjectFutureImprovement[]
  serviceProject Project? @relation("ErpServiceProject")

  @@index([status])
  @@index([departmentId])
  @@index([customerId])
  @@index([nextPaymentAt])
}

/// Client-facing update log (feeds email templates)
model ProjectClientUpdate {
  id           String     @id @default(cuid())
  projectId    String
  project      ErpProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  body         String
  /// Optional process stage at time of update
  processStage String?
  createdById  String?
  createdAt    DateTime   @default(now())

  @@index([projectId])
  @@index([createdAt])
}

/// Technical resources and credentials for a delivery project (Phase 9)
model ProjectResource {
  id                  String          @id @default(cuid())
  projectId           String          @unique
  project             ErpProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  gitRepoUrl          String?
  gitProvider         String?
  defaultBranch       String?
  deploymentBranch    String?
  latestCommitSha     String?
  latestCommitMessage String?
  latestCommitAt      DateTime?
  repositoryStatus    String?         @default("UNKNOWN")
  devEnvironmentUrl   String?
  productionEnvironmentUrl String?
  clientCanViewGit    Boolean         @default(false)
  sourceCodeNotes     String?
  docsUrl             String?
  apiDocsUrl          String?
  deploymentMethod    String?
  lastDeployedAt      DateTime?
  lastDeployedVersion String?
  hostingAccountId    String?
  hostingAccount      HostingAccount? @relation(fields: [hostingAccountId], references: [id], onDelete: SetNull)
  domainId            String?
  domain              Domain?         @relation(fields: [domainId], references: [id], onDelete: SetNull)
  /// Encrypted JSON object of environment variables
  envVarsEncrypted    String?
  /// Encrypted JSON array of credential entries
  credentialsEncrypted String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  createdBy           String?
  updatedBy           String?
  deletedAt           DateTime?

  @@index([hostingAccountId])
  @@index([domainId])
  @@index([deletedAt])
}

/// Backlog / future improvements not yet scheduled (Phase 11)
model ProjectFutureImprovement {
  id          String     @id @default(cuid())
  projectId   String
  project     ErpProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  /// BACKLOG | SCHEDULED | DONE | DROPPED
  status      String     @default("BACKLOG")
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@index([projectId])
  @@index([status])
  @@index([deletedAt])
}

/// Project cost / expense lines (drives spentCents + profit)
model ProjectExpense {
  id          String     @id @default(cuid())
  projectId   String
  project     ErpProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  category    String     @default("GENERAL")
  amountCents Int
  expenseDate DateTime   @default(now())
  notes       String?
  createdById String?
  createdAt   DateTime   @default(now())

  @@index([projectId])
  @@index([expenseDate])
}

/// Installment / milestone payment schedule for a project
model ProjectPaymentSchedule {
  id          String     @id @default(cuid())
  projectId   String
  project     ErpProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label       String
  amountCents Int
  dueDate     DateTime
  /// PENDING | INVOICED | PAID | OVERDUE | WAIVED
  status      String     @default("PENDING")
  invoiceId   String?
  invoice     Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paidAt      DateTime?
  notes       String?
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  @@index([projectId])
  @@index([dueDate])
  @@index([status])
}

model ProjectMember {
  id           String     @id @default(cuid())
  projectId    String
  project      ErpProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// LEAD | MEMBER | VIEWER (legacy display role)
  role         String     @default("MEMBER")
  /// view | edit | admin — enforced at API layer
  accessLevel  String     @default("edit")
  assignedById String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([deletedAt])
}

model ProjectTask {
  id               String     @id @default(cuid())
  projectId        String
  project          ErpProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId      String?
  milestone        ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  /// Parent task for subtasks (project → milestone → task → subtask)
  parentId         String?
  parent           ProjectTask?  @relation("TaskTree", fields: [parentId], references: [id], onDelete: Cascade)
  children         ProjectTask[] @relation("TaskTree")
  title            String
  description      String?
  /// TODO | IN_PROGRESS | IN_REVIEW | DONE | BLOCKED
  status           String     @default("TODO")
  /// CRITICAL | HIGH | MEDIUM | LOW
  priority         String     @default("MEDIUM")
  /// 0–100
  progressPct      Int        @default(0)
  assigneeId       String?
  assignee         User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  delegatedById    String?
  delegatedBy      User?      @relation("TaskDelegator", fields: [delegatedById], references: [id], onDelete: SetNull)
  estimateMinutes  Int        @default(0)
  trackedMinutes   Int        @default(0)
  startDate        DateTime?
  dueDate          DateTime?
  sortOrder        Int        @default(0)
  /// NONE | DAILY | WEEKLY | MONTHLY | YEARLY
  recurrence       String     @default("NONE")
  recurrenceParentId String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  dependencies     TaskDependency[] @relation("DependentTask")
  blocks           TaskDependency[] @relation("BlockingTask")
  comments         TaskComment[]
  attachments      TaskAttachment[]
  timeEntries      TaskTimeEntry[]

  @@index([projectId])
  @@index([milestoneId])
  @@index([parentId])
  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([dueDate])
}

/// Task A depends on Task B finishing (critical path / blockers)
model TaskDependency {
  id          String      @id @default(cuid())
  taskId      String
  task        ProjectTask @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn   ProjectTask @relation("BlockingTask", fields: [dependsOnId], references: [id], onDelete: Cascade)
  /// FINISH_TO_START | START_TO_START | FINISH_TO_FINISH
  type        String      @default("FINISH_TO_START")
  createdAt   DateTime    @default(now())

  @@unique([taskId, dependsOnId])
  @@index([taskId])
  @@index([dependsOnId])
}

model TaskComment {
  id        String      @id @default(cuid())
  taskId    String
  task      ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime    @default(now())

  @@index([taskId])
  @@index([createdAt])
}

model TaskAttachment {
  id           String      @id @default(cuid())
  taskId       String
  task         ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  mimeType     String?
  sizeBytes    Int?
  uploadedById String?
  uploadedBy   User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@index([taskId])
}

/// Pomodoro / manual time tracking
model TaskTimeEntry {
  id        String      @id @default(cuid())
  taskId    String
  task      ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// POMODORO | MANUAL
  kind      String      @default("MANUAL")
  minutes   Int
  startedAt DateTime?
  endedAt   DateTime?
  note      String?
  createdAt DateTime    @default(now())

  @@index([taskId])
  @@index([userId])
  @@index([createdAt])
}

model FinanceEntry {
  id          String   @id @default(cuid())
  entryNumber String   @unique
  /// INCOME | EXPENSE | TRANSFER | ADJUSTMENT
  type        String
  category    String
  description String
  amountCents Int
  currency    String   @default("LKR")
  entryDate   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  reference   String?
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([entryDate])
  @@index([category])
}

model Asset {
  id            String    @id @default(cuid())
  assetCode     String    @unique
  name          String
  category      String
  /// AVAILABLE | ASSIGNED | MAINTENANCE | RETIRED
  status        String    @default("AVAILABLE")
  location      String?
  purchaseCents   Int       @default(0)
  purchaseDate    DateTime?
  assignedTo      String?
  /// Useful life years for depreciation
  usefulLifeYears Int       @default(5)
  salvageCents    Int       @default(0)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  maintenance AssetMaintenance[]

  @@index([status])
  @@index([category])
}

model InventoryItem {
  id            String   @id @default(cuid())
  sku           String   @unique
  name          String
  category      String
  quantity      Int      @default(0)
  reorderLevel  Int      @default(5)
  unitCostCents Int      @default(0)
  warehouseId   String?
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  batchCode     String?
  expiresAt     DateTime?
  barcode       String?
  location      String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  movements StockMovement[]

  @@index([category])
  @@index([warehouseId])
}

model WorkOrder {
  id          String    @id @default(cuid())
  workNumber  String    @unique
  title       String
  description String?
  /// OPEN | SCHEDULED | IN_PROGRESS | DONE | CANCELLED
  status      String    @default("OPEN")
  /// LOW | MEDIUM | HIGH | URGENT
  priority    String    @default("MEDIUM")
  assetCode     String?
  assigneeId    String?
  assignee      User?     @relation("WorkOrderAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate       DateTime?
  scheduledAt   DateTime?
  latitude      Float?
  longitude     Float?
  customerSign  String?
  serviceReport String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([assigneeId])
}

model StaffPermission {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  createdAt  DateTime @default(now())

  @@unique([userId, permission])
  @@index([userId])
}

/// —— Part 05 expanded modules ——

model AttendanceRecord {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  workDate   DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  /// PRESENT | ABSENT | LATE | HALF_DAY | REMOTE
  status     String    @default("PRESENT")
  notes      String?
  /// Minutes of approved overtime for this day
  overtimeMinutes Int   @default(0)
  shiftId    String?
  shift      WorkShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([employeeId])
  @@index([workDate])
  @@index([userId])
  @@index([shiftId])
}

model PayrollRun {
  id          String       @id @default(cuid())
  runNumber   String       @unique
  periodLabel String
  /// DRAFT | APPROVED | PAID
  status      String       @default("DRAFT")
  totalCents  Int          @default(0)
  createdAt   DateTime     @default(now())
  lines       PayrollLine[]
}

model PayrollLine {
  id           String     @id @default(cuid())
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  grossCents   Int
  deductionsCents Int     @default(0)
  netCents     Int
  notes        String?

  @@index([payrollRunId])
  @@index([employeeId])
}

model JobOpening {
  id          String   @id @default(cuid())
  title       String
  department  String?
  description String?
  /// Public-facing location e.g. "Colombo (Hybrid)" / "Remote"
  location    String?
  /// FULL_TIME | PART_TIME | CONTRACT | INTERNSHIP
  employmentType String @default("FULL_TIME")
  /// True for internship listings (careers page groups these separately)
  isInternship Boolean @default(false)
  /// JSON string array of responsibilities / requirements
  requirementsJson String?
  /// OPEN | CLOSED | FILLED
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  applications JobApplication[]

  @@index([status])
  @@index([isInternship])
}

model JobApplication {
  id           String     @id @default(cuid())
  jobOpeningId String
  jobOpening   JobOpening @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  fullName     String
  email        String
  phone        String?
  resumeUrl    String?
  /// Applicant cover letter / message (from public careers form)
  coverLetter  String?
  /// Origin of the application e.g. "careers-page"
  source       String?
  /// NEW | SCREENING | INTERVIEW | OFFER | HIRED | REJECTED
  status       String     @default("NEW")
  notes        String?
  createdAt    DateTime   @default(now())

  @@index([jobOpeningId])
  @@index([status])
}

model Vendor {
  id          String   @id @default(cuid())
  vendorCode  String   @unique
  name        String
  email       String?
  phone       String?
  address     String?
  category    String?
  ownerId     String?
  owner       User?    @relation("VendorOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  /// ACTIVE | INACTIVE | BLOCKED
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  purchaseOrders PurchaseOrder[]

  @@index([status])
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  poNumber    String   @unique
  vendorId    String?
  vendor      Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  description String
  amountCents Int
  /// DRAFT | SUBMITTED | APPROVED | ORDERED | RECEIVED | CANCELLED
  status      String   @default("DRAFT")
  orderedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([vendorId])
  @@index([status])
}

model Warehouse {
  id        String          @id @default(cuid())
  code      String          @unique
  name      String
  location  String?
  createdAt DateTime        @default(now())
  items     InventoryItem[]
}

model StockMovement {
  id        String        @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// IN | OUT | ADJUST | TRANSFER
  type      String
  quantity  Int
  note      String?
  createdAt DateTime      @default(now())

  @@index([itemId])
  @@index([createdAt])
}

model Bom {
  id          String    @id @default(cuid())
  bomCode     String    @unique
  productName String
  description String?
  createdAt   DateTime  @default(now())
  lines       BomLine[]
  productionOrders ProductionOrder[]
}

model BomLine {
  id          String @id @default(cuid())
  bomId       String
  bom         Bom    @relation(fields: [bomId], references: [id], onDelete: Cascade)
  componentSku String
  quantity    Float  @default(1)
}

model ProductionOrder {
  id          String   @id @default(cuid())
  orderNumber String   @unique
  bomId       String?
  bom         Bom?     @relation(fields: [bomId], references: [id], onDelete: SetNull)
  productName String
  quantity    Int      @default(1)
  /// PLANNED | IN_PROGRESS | QC | DONE | CANCELLED
  status      String   @default("PLANNED")
  createdAt   DateTime @default(now())

  @@index([status])
}

model AssetMaintenance {
  id          String   @id @default(cuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title       String
  /// SCHEDULED | IN_PROGRESS | DONE
  status      String   @default("SCHEDULED")
  scheduledAt DateTime?
  costCents   Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())

  @@index([assetId])
  @@index([status])
}

model ServiceCatalogItem {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  category    String
  description String?
  slaHours    Int      @default(24)
  active      Boolean  @default(true)
}

model EsIncident {
  id          String   @id @default(cuid())
  incidentNumber String @unique
  title       String
  description String?
  /// INCIDENT | PROBLEM | CHANGE | REQUEST
  type        String   @default("INCIDENT")
  /// OPEN | IN_PROGRESS | RESOLVED | CLOSED
  status      String   @default("OPEN")
  priority    String   @default("MEDIUM")
  slaDueAt    DateTime?
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([type])
}

model ProjectMilestone {
  id          String     @id @default(cuid())
  projectId   String
  project     ErpProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startDate   DateTime?
  dueDate     DateTime?
  /// PENDING | IN_PROGRESS | DONE
  status      String     @default("PENDING")
  /// 0–100 (derived from tasks when synced)
  progressPct Int        @default(0)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  tasks ProjectTask[]

  @@index([projectId])
  @@index([status])
}

model IotDevice {
  id          String   @id @default(cuid())
  deviceCode  String   @unique
  name        String
  location    String?
  /// ONLINE | OFFLINE | ALERT
  status      String   @default("ONLINE")
  lastSeenAt  DateTime?
  healthScore Int      @default(100)
  createdAt   DateTime @default(now())
  readings    IotReading[]

  @@index([status])
}

model IotReading {
  id        String    @id @default(cuid())
  deviceId  String
  device    IotDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  metric    String
  value     Float
  unit      String?
  createdAt DateTime  @default(now())

  @@index([deviceId])
  @@index([createdAt])
}

model Document {
  id          String   @id @default(cuid())
  docNumber   String   @unique
  title       String
  category    String
  /// Folder path e.g. Policies/HR
  folder      String   @default("General")
  /// DRAFT | PENDING | APPROVED | ARCHIVED
  status      String   @default("DRAFT")
  version     Int      @default(1)
  fileUrl     String?
  /// JSON ACL: { view: userIds[], edit: userIds[], download: userIds[] }
  aclJson     String?
  /// Template key from library
  templateKey String?
  /// Extracted / OCR text for full-text search
  ocrText     String?
  expiresAt   DateTime?
  signedAt    DateTime?
  signedById  String?
  uploaderId        String?
  uploader          User?            @relation("DocUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  customerProfileId String?
  customerProfile   CustomerProfile? @relation("ClientDocuments", fields: [customerProfileId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  versions          DocumentVersion[]

  @@index([category])
  @@index([folder])
  @@index([status])
  @@index([expiresAt])
  @@index([customerProfileId])
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    Int
  fileUrl    String?
  notes      String?
  uploaderId String?
  uploader   User?    @relation("DocVersionUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@unique([documentId, version])
  @@index([documentId])
}

model InternalMessage {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("MsgSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String?
  recipient   User?    @relation("MsgRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  /// Channel name or dm:{sortedUserIds}
  channel     String   @default("general")
  threadId    String?
  body        String
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([channel])
  @@index([threadId])
  @@index([recipientId])
  @@index([createdAt])
}

model AiInsight {
  id        String   @id @default(cuid())
  title     String
  category  String
  summary   String
  payload   String?
  createdAt DateTime @default(now())

  @@index([category])
}

/// —— Part 05: Organization OS (multi-tenant ready) ——

model Organization {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  legalName   String?
  taxId       String?
  email       String?
  phone       String?
  address     String?
  country     String?  @default("Sri Lanka")
  /// ACTIVE | INACTIVE
  status      String   @default("ACTIVE")
  /// SaaS tenant flag — MernCrest is primary tenant
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  branches            Branch[]
  supportAgents       SupportAgent[]
  aiProviderConfigs   AiProviderConfig[]
  aiAssistantConfigs  AiAssistantConfig[]
  aiCallLogs          AiCallLog[]
  messageTemplates    MessageTemplate[]
  orgNumberSequences  OrgNumberSequence[]
  emailOutbox         EmailOutbox[]
  emailNotifySettings EmailNotifySetting[]

  @@index([status])
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  city           String?
  address        String?
  phone          String?
  /// ACTIVE | INACTIVE
  status         String       @default("ACTIVE")
  isHeadOffice   Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  employees      Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
}

/// System-wide audit trail for ERP / CRM / Finance actions
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  actorName  String?
  /// LOGIN | LOGOUT | CREATE | UPDATE | DELETE | APPROVE | REJECT | PAYMENT | INVENTORY | FINANCE | SETTINGS | EXPORT
  action     String
  module     String
  entityType String?
  entityId   String?
  summary    String
  metaJson   String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([module])
  @@index([action])
  @@index([actorId])
  @@index([createdAt])
  @@index([entityType, entityId])
}

/// Generic multi-level approval requests (leave, PO, expense, quote, project, invoice)
model ApprovalRequest {
  id           String    @id @default(cuid())
  requestNumber String   @unique
  /// LEAVE | PURCHASE | EXPENSE | QUOTATION | PROJECT | INVOICE | DOCUMENT | CUSTOM
  type         String
  title        String
  description  String?
  /// PENDING | APPROVED | REJECTED | CANCELLED
  status       String    @default("PENDING")
  requesterId  String
  approverId   String?
  referenceType String?
  referenceId  String?
  amountCents  Int?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([type])
  @@index([status])
  @@index([requesterId])
  @@index([approverId])
  @@index([createdAt])
}

/// Chart of Accounts — foundation for GL / AR / AP
model ChartOfAccount {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  /// ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  type        String
  parentCode  String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([active])
}

/// ESS salary slips generated from payroll runs
model SalarySlip {
  id           String   @id @default(cuid())
  slipNumber   String   @unique
  employeeId   String
  payrollRunId String?
  periodLabel  String
  grossCents   Int
  deductionsCents Int   @default(0)
  netCents     Int
  currency     String   @default("LKR")
  /// DRAFT | ISSUED | PAID
  status       String   @default("ISSUED")
  issuedAt     DateTime @default(now())
  metaJson     String?
  createdAt    DateTime @default(now())

  @@index([employeeId])
  @@index([payrollRunId])
  @@index([periodLabel])
}

/// —— Part 06: Platform Administration (database-driven config) ——

/// Key/value platform settings (company, branding, security, email, maintenance…)
model SystemSetting {
  id          String   @id @default(cuid())
  /// e.g. company.name | branding.primaryColor | security.sessionDays | maintenance.enabled
  key         String   @unique
  value       String
  /// STRING | NUMBER | BOOLEAN | JSON
  valueType   String   @default("STRING")
  group       String   @default("general")
  label       String?
  description String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([group])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  enabled     Boolean  @default(false)
  /// STABLE | BETA | EXPERIMENTAL
  tier        String   @default("STABLE")
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
